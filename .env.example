# ==============================================================================
# Vehicle Maintenance & Operations Tracker - Environment Configuration
# Copy this file to .env on your QNAP NAS and customize the values.
# ==============================================================================

# ------------------------------------------------------------------------------
# Network & Tailscale Configuration
# ------------------------------------------------------------------------------
# Configured for your QNAP NAS and Tailnet:
# - Option A (Tailscale MagicDNS - Recommended): http://nas6e810d.tail8ba0ff.ts.net:8000
# - Option B (Tailscale Direct IP):              http://100.91.20.86:8000
# - Option C (Local LAN IP):                     http://192.168.1.198:8000
#
# IMPORTANT: This URL is the default encoded into printable vehicle QR codes for mobile scanning.
BASE_PUBLIC_URL=http://nas6e810d.tail8ba0ff.ts.net:8000


# ------------------------------------------------------------------------------
# Storage Configuration
# ------------------------------------------------------------------------------
# Internal path inside the container for SQLite DB and uploaded documents.
DATA_DIR=/app/data

# ------------------------------------------------------------------------------
# Security & Defense-in-Depth Authentication
# ------------------------------------------------------------------------------
# Set to 'true' to require HTTP Basic Auth credentials even on your Tailnet.
# Set to 'false' (default) to rely solely on Tailscale's zero-trust device perimeter.
ENABLE_AUTH=false
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme_to_a_strong_password

# ------------------------------------------------------------------------------
# Notification & Cooldown Settings
# ------------------------------------------------------------------------------
# Minimum hours between duplicate alert dispatches for the same item.
NOTIFICATION_COOLDOWN_HOURS=24

# ------------------------------------------------------------------------------
# Google Calendar Integration (Optional)
# ------------------------------------------------------------------------------
# Target Calendar ID:
# - Use 'primary' to publish to your main Google Calendar.
# - OR use a dedicated secondary calendar ID (e.g. c_xxxxxx@group.calendar.google.com)
GOOGLE_CALENDAR_ID=primary

# OAuth Client Credentials (from Google Cloud Console):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

